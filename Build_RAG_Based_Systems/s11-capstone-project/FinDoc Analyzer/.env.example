# FinDoc Analyzer — Environment Variables
# cp .env.example .env  then fill in your values

# ══════════════════════════════════════════════════════════
# LLM PROVIDER SELECTION  (Gap Fix)
# Options: azure | anthropic | openai
# ══════════════════════════════════════════════════════════
LLM_PROVIDER=azure

# Embedding provider when LLM_PROVIDER=anthropic
# (Anthropic has no embedding API — must use azure or openai)
EMBEDDING_PROVIDER=openai

# ══════════════════════════════════════════════════════════
# OPTION A: Azure OpenAI  (LLM_PROVIDER=azure)
# ══════════════════════════════════════════════════════════
AZURE_OPENAI_API_KEY=your-azure-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_LLM_MODEL=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ══════════════════════════════════════════════════════════
# OPTION B: Anthropic Claude  (LLM_PROVIDER=anthropic)
# Gap Fix: ANTHROPIC_API_KEY now fully supported
# ══════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ══════════════════════════════════════════════════════════
# OPTION C: OpenAI Direct  (LLM_PROVIDER=openai)
# ══════════════════════════════════════════════════════════
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ══════════════════════════════════════════════════════════
# PostgreSQL Database  (Required for all providers)
# ══════════════════════════════════════════════════════════
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=findoc_db
DB_TABLE_NAME=findoc_embeddings
DB_FINANCE_TABLE=financial_statements

# ══════════════════════════════════════════════════════════
# Langfuse — Evaluation & Tracing (Sprint9)
# https://cloud.langfuse.com → Settings → API Keys
# ══════════════════════════════════════════════════════════
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ══════════════════════════════════════════════════════════
# MCP + HuggingFace  (Sprint8)
# https://huggingface.co/settings/tokens
# ══════════════════════════════════════════════════════════
HF_TOKEN=hf_...
MCP_SERVER_URL=https://huggingface.co/mcp

# ══════════════════════════════════════════════════════════
# Human Handoff — SMTP Email  (Sprint10)
# ══════════════════════════════════════════════════════════
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-app@gmail.com
SMTP_PASSWORD=your-app-password
APPLICATION_EMAIL=findoc@yourdomain.com
SUPPORT_EMAIL=financial-experts@yourdomain.com

# ══════════════════════════════════════════════════════════
# SLO Thresholds  (Sprint9 — optional overrides)
# ══════════════════════════════════════════════════════════
SLO_FAITHFULNESS_MIN=0.6
SLO_RELEVANCE_MIN=0.5
SLO_LATENCY_MAX_MS=5000

# ══════════════════════════════════════════════════════════
# Handoff Thresholds  (Sprint10 — optional overrides)
# ══════════════════════════════════════════════════════════
HANDOFF_FAITHFULNESS_THRESHOLD=0.6
HANDOFF_RELEVANCE_THRESHOLD=0.5
HANDOFF_CONFIDENCE_THRESHOLD=40

# ══════════════════════════════════════════════════════════
# App Settings
# ══════════════════════════════════════════════════════════
MAX_FILE_SIZE_MB=50
