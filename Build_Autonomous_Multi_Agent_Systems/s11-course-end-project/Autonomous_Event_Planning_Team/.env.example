# Copy this file to `.env` in the project root and fill in the values you
# need. See README.md > Configuration for what each variable does and which
# ones are required to boot the app vs. optional/best-effort.

# ---- Primary LLM: Azure OpenAI (used for tier="reasoning" calls) ----------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_LLM_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# ---- Fallback LLM: Gemini (used for tier="reasoning" if Azure fails) ------
GEMINI_API_KEY=
GEMINI_MODEL_NAME=

# ---- Local helper LLM: Ollama (used for tier="helper" calls only) ---------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=phi3:mini

# ---- Security / PII scrubbing (best-effort — no-ops if disabled/missing) --
PII_ENGINE=presidio
PRESIDIO_ENABLED=true
GUARDRAILS_API_KEY=

# ---- Observability (best-effort — tracing no-ops if unset) ----------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---- App behavior -----------------------------------------------------------
DEBUG_MODE=
MAX_ITERATIONS=3
# Comma-separated origins allowed to call this API cross-origin (e.g. your
# deployed front-end's Vercel URL). "*" (default) allows any origin.
CORS_ALLOWED_ORIGINS=*
# Optional, defaults to 0.80 if unset — minimum weighted reflection score
# (see app/agents/reflection_agent.py) required to finalize a plan.
# QUALITY_GATE_THRESHOLD=0.80
