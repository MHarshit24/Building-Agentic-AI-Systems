# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different models/operating systems
#   you may want to ignore Pipfile.lock to prevent conflicts:
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally tracked in version control.
#   However, if you feel otherwise, ignore it:
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally tracked in version control.
#pdm.lock
#   pdm build stage status
.pdm-build/

# PEP 582; project local packages directory (used by pdm)
__pypackages__/

