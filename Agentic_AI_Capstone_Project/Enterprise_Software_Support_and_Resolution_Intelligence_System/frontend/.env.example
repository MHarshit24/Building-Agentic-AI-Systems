# Backend base URL. Points at the local FastAPI dev server by default;
# set to the deployed Render/Railway URL for a Vercel production build.
VITE_API_BASE_URL=http://localhost:8000

# When "true", MSW intercepts every API call in-browser with realistic
# fixture data (src/mocks/) — no real backend or LLM call happens.
# Set to "false" to talk to a real running backend.
VITE_USE_MOCKS=true
