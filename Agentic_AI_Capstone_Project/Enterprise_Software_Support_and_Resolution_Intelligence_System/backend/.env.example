# backend/.env.example
#
# Project-scoped values (config.py's "dual-.env pattern" — this file is
# loaded second, with override=True, on top of the root .env that holds
# account-level secrets shared across assignments: AZURE_OPENAI_*,
# LANGFUSE_*, DB_HOST/DB_PORT/DB_USER/DB_PASSWORD, SMTP_*).

JWT_SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call this API from a browser.
# Defaults to the local Vite dev server if unset. Add the deployed Vercel
# URL here once the frontend is deployed.
CORS_ALLOWED_ORIGINS=http://localhost:5173

MCP_NOTIFICATION_URL=http://localhost:9000/notify

REDIS_URL=redis://localhost:6379/1

DB_NAME=enterprise_support_intelligence_db

# ---------------------------------------------------------------------------
# Seeded demo/test accounts (scripts/seed_synthetic_data.py, §22.1)
#
# Fixed, idempotent local/dev roster — not real secrets, safe to commit.
# POST /auth/login against any of these after running the seed script:
#
#   admin1@enterprise-support.local   (admin)
#   admin2@enterprise-support.local   (admin)
#   agent1@enterprise-support.local   (support_agent)
#   agent2@enterprise-support.local   (support_agent)
#   agent3@enterprise-support.local   (support_agent)
#
#   Password (all five accounts): DevPassword123!
# ---------------------------------------------------------------------------
