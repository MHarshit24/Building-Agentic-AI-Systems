[run]
# app/ is the deployed application; mcp_servers/ is the notification MCP
# server — its own core logic (_send_escalation_email_impl etc.) is
# exercised by direct in-process calls in tests/integration/
# test_escalation_mcp.py, not just the one real-subprocess eval test, so
# it belongs in scope, not omitted; evaluation/ is the golden-eval/
# calibration tooling, also real application code with its own tests.
source =
    app
    mcp_servers
    evaluation
omit =
    */scripts/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
