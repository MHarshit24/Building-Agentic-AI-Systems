<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS Deployment Configuration — Job Placement Agent Frontend (Streamlit)
  -----------------------------------------------------------------------
  Requires: IIS HttpPlatformHandler v1.2+  AND  WebSocket Protocol feature
  Site Port: 8501  (configurable in deploy-iis.ps1)
  Run deploy-iis.ps1 as Administrator to set up IIS automatically.
-->
<configuration>
  <system.webServer>

    <!-- Route every request through HttpPlatformHandler → Streamlit -->
    <handlers>
      <add name="JobAgentFrontendHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <!--
      processPath : Python in the project virtual environment (created by deploy-iis.ps1)
      arguments   : launch streamlit in headless mode on the IIS-assigned port
                    --server.enableCORS false        → handled by IIS
                    --server.enableXsrfProtection false → behind IIS proxy
      requestTimeout: 4 min — agent tool calls can be slow
    -->
    <httpPlatform processPath=".\venv\Scripts\python.exe"
                  arguments="-m streamlit run app.py
                             --server.port %HTTP_PLATFORM_PORT%
                             --server.address 127.0.0.1
                             --server.headless true
                             --server.enableCORS false
                             --server.enableXsrfProtection false"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\streamlit.log"
                  startupTimeLimit="120"
                  requestTimeout="00:04:00"
                  processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value="." />
        <environmentVariable name="PORT"       value="%HTTP_PLATFORM_PORT%" />
      </environmentVariables>
    </httpPlatform>

    <!-- Enable WebSocket protocol — required by Streamlit for live updates -->
    <webSocket enabled="true" />

  </system.webServer>
</configuration>
