<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS Deployment Configuration — Job Placement Agent Backend (FastAPI + Uvicorn)
  -------------------------------------------------------------------------------
  Requires: IIS HttpPlatformHandler v1.2+
  Site Port: 8000  (configurable in deploy-iis.ps1)
  Run deploy-iis.ps1 as Administrator to set up IIS automatically.
-->
<configuration>
  <system.webServer>

    <!-- Route every request through HttpPlatformHandler → Uvicorn -->
    <handlers>
      <add name="JobAgentBackendHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <!--
      processPath : Python in the project virtual environment (created by deploy-iis.ps1)
      arguments   : launch uvicorn; %HTTP_PLATFORM_PORT% is set automatically by IIS
      requestTimeout: 4 min — LLM calls can take up to 90 s
    -->
    <httpPlatform processPath=".\venv\Scripts\python.exe"
                  arguments="-m uvicorn main:app
                             --host 127.0.0.1
                             --port %HTTP_PLATFORM_PORT%
                             --workers 1
                             --log-level info"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\uvicorn.log"
                  startupTimeLimit="60"
                  requestTimeout="00:04:00"
                  processesPerApplication="1">
      <environmentVariables>
        <!-- Ensure backend modules resolve from the app root -->
        <environmentVariable name="PYTHONPATH" value="." />
        <!-- Expose the dynamic IIS port to the app if needed -->
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
      </environmentVariables>
    </httpPlatform>

    <!-- Allow all REST verbs (IIS blocks DELETE/PATCH by default) -->
    <security>
      <requestFiltering>
        <verbs allowUnlisted="false">
          <add verb="GET"     allowed="true" />
          <add verb="POST"    allowed="true" />
          <add verb="PUT"     allowed="true" />
          <add verb="DELETE"  allowed="true" />
          <add verb="PATCH"   allowed="true" />
          <add verb="OPTIONS" allowed="true" />
          <add verb="HEAD"    allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
